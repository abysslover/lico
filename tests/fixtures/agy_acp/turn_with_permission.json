  "[session started] model=gemini-4-neon-high",
  "I will list the files.",
  "One moment",
  "$ ls -la",
  "> a.txt",
  "> b.txt",
  "Done: a.txt and b.txt.",
  "[turn completed]"
 ],
 "approvals": [
  {
   "request_id": 100,
   "prompt": "run: ls -la",
   "options": [
    {
     "optionId": "allow",
     "kind": "allow_once",
     "name": "Allow"
    },
    {
     "optionId": "always",
     "kind": "allow_always",
     "name": "Always allow"
    },
    {
     "optionId": "reject",
     "kind": "reject_once",
     "name": "Reject"
    }
