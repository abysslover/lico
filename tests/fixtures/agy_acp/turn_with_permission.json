{
 "name": "turn_with_permission",
 "source": "Hand-made from the Agent Client Protocol documentation; initialize and session/new follow what agy 1.5.18 answered in a private empty home (no sign-in, no turn). Everything from the first session/prompt on is unverified.",
 "unverified": [
  "the updates of a turn (agent_message_chunk, tool_call, tool_call_update)",
  "the permission request and its option kinds",
  "the stop reasons",
  "the error of a prompt without a sign-in"
 ],
 "stream": [
  {
   "dir": "host",
   "msg": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
     "protocolVersion": 1,
     "clientCapabilities": {
      "fs": {
       "readTextFile": false,
       "writeTextFile": false
      },
      "terminal": false
     },
     "clientInfo": {
      "name": "lico",
      "version": "0"
     }
    }
   }
  },
  {
   "dir": "agent",
   "msg": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
     "protocolVersion": 1,
     "agentCapabilities": {
      "loadSession": true,
      "promptCapabilities": {
       "image": true,
       "audio": false,
       "embeddedContext": true
      },
      "sessionCapabilities": {
       "resume": {},
       "close": {},
       "load": {},
       "list": {},
       "additionalDirectories": {}
      }
     },
     "agentInfo": {
      "name": "Antigravity ACP Server",
      "version": "1.5.18"
     },
     "authMethods": [
      {
       "id": "oauth-personal",
       "name": "Log in with Google",
       "description": "Log in with your Google account"
      }
     ]
    }
   }
  },
  {
   "dir": "host",
   "msg": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "session/new",
    "params": {
     "cwd": "/work",
     "mcpServers": []
    }
   }
  },
  {
   "dir": "agent",
   "msg": {
    "jsonrpc": "2.0",
    "id": 2,
