       "command": "ls -la"
      }
     },
     "options": [
      {
       "optionId": "allow",
       "name": "Allow",
       "kind": "allow_once"
      },
      {
       "optionId": "always",
       "name": "Always allow",
       "kind": "allow_always"
      },
      {
       "optionId": "reject",
       "name": "Reject",
       "kind": "reject_once"
      }
     ]
    }
   }
  },
  {
   "dir": "host",
   "msg": {
    "jsonrpc": "2.0",
    "id": 100,
    "result": {
     "outcome": {
      "outcome": "selected",
      "optionId": "allow"
     }
    }
