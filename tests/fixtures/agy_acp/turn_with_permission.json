         "text": "a.txt\nb.txt"
        }
       }
      ]
     }
    }
   }
  },
  {
   "dir": "agent",
   "msg": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
     "sessionId": "s-1",
     "update": {
      "sessionUpdate": "agent_message_chunk",
      "content": {
       "type": "text",
       "text": "Done: a.txt and b.txt."
      }
     }
    }
   }
  },
  {
   "dir": "agent",
   "msg": {
    "jsonrpc": "2.0",
    "id": 3,
    "result": {
     "stopReason": "end_turn"
    }
