    {"text": "sonnet ", "why": "a trailing space"},
    {"text": "a/b", "why": "a slash"},
    {"text": "a\\b", "why": "a backslash"},
    {"text": "a\u0000b", "why": "a NUL"},
    {"text": "sonnet\n", "why": "a trailing line break"},
    {"text": "so\nnnet", "why": "a line break inside"},
    {"text": "a\tb", "why": "a tab"},
    {"text": "café", "why": "a letter outside ASCII"},
    {"text": "한글", "why": "Hangul"},
    {"text": "é", "why": "a first character that is a letter outside ASCII"},
    {"text": "²", "why": "a digit outside ASCII"},
    {"text": "a;b", "why": "a semicolon"},
    {"text": "a$(x)", "why": "shell syntax"},
    {"unit": "é", "times": 31, "why": "62 bytes of letters outside ASCII"}
