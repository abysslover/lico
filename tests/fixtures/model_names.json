    {"text": "my_model_v2", "why": "underscores inside"},
    {"text": "5o", "why": "a digit first"},
    {"text": "A", "why": "one capital letter"},
    {"text": "a.b_c-d", "why": "all three marks inside"},
    {"unit": "m", "times": 60, "why": "exactly the limit"}
